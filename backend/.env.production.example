ENVIRONMENT=production
DEBUG=False
PROJECT_NAME=JARI Backend API
API_V1_STR=/api/v1

SECRET_KEY=generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

POSTGRES_USER=jari_user
POSTGRES_PASSWORD=generate_strong_password_here
POSTGRES_DB=jari_db
DATABASE_URL=postgresql+psycopg://jari_user:${POSTGRES_PASSWORD}@db:5432/jari_db

BACKEND_CORS_ORIGINS=["https://jari-jet.vercel.app","http://localhost:3000"]

